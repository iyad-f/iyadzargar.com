package views

import "github.com/iyad-f/iyadzargar.com/internal/content"

templ Projects(site content.Site) {
	@Base(site.Owner, "Projects", "projects") {
		@pageShell(true) {
			@eyebrow("Curiosity compiled")
			<h1 class="mt-6 font-mono text-3xl font-bold tracking-tight text-ink sm:text-5xl">
				Things I have built
			</h1>
			<p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/80">
				A collection of my favourite projects and experiments.
			</p>
			<div id="filters" class="mt-10 flex flex-wrap gap-2 text-xs">
				@filterPill("all", "All", true)
				@filterPill("go", "Go", false)
				@filterPill("rust", "Rust", false)
				@filterPill("python", "Python", false)
			</div>
			<div id="grid" class="mt-10 grid gap-6 sm:grid-cols-2">
				for _, p := range site.Projects {
					@projectCard(p)
				}
			</div>
		}
	}
}
