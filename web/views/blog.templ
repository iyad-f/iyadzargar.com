package views

import (
	"strconv"

	"github.com/iyad-f/iyadzargar.com/internal/content"
)

// postPath is the URL path of a post.
func postPath(p content.Post) string { return "/blog/" + p.Slug }

// readingTime is a post's reading time as shown to visitors.
func readingTime(p content.Post) string { return strconv.Itoa(p.ReadingTime) + " min read" }

templ Blog(site content.Site) {
	@Base(site.Owner, "Blog", "blog") {
		@pageShell(true) {
			@eyebrow("Notes from the layer underneath")
			<h1 class="mt-6 font-mono text-3xl font-bold tracking-tight text-ink sm:text-5xl">
				Writing
			</h1>
			<p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/80">
				Deep dives into systems, compilers and whatever I am taking apart at the moment.
			</p>
			if len(site.Posts) == 0 {
				<p class="mt-16 font-mono text-sm text-muted">Nothing here yet. The first post is on its way.</p>
			} else {
				<ol class="mt-12 divide-y divide-line border-y border-line">
					for _, p := range site.Posts {
						<li>
							@postItem(p)
						</li>
					}
				</ol>
			}
		}
	}
}

templ postItem(p content.Post) {
	<article class="group relative py-8">
		@postMeta(p)
		<h2 class="mt-3 font-mono text-xl font-bold text-ink transition-colors group-hover:text-signal sm:text-2xl">
			{ p.Title }
		</h2>
		<p class="mt-3 max-w-3xl leading-relaxed text-muted">{ p.Summary }</p>
		@postTags(p)
		<a
			href={ templ.URL(postPath(p)) }
			class="absolute inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
			aria-label={ p.Title }
		></a>
	</article>
}

// postMeta is the date and reading time line, flagged when the post is a draft.
templ postMeta(p content.Post) {
	<p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-label text-muted">
		<time datetime={ p.Date.Format("2006-01-02") }>{ p.Date.Format("January 2, 2006") }</time>
		<span aria-hidden="true">·</span>
		<span>{ readingTime(p) }</span>
		if p.Draft {
			<span class="rounded-full border border-term-warn/40 px-2 py-0.5 text-term-warn">Draft</span>
		}
	</p>
}

templ postTags(p content.Post) {
	if len(p.Tags) > 0 {
		<div class="mt-5 flex flex-wrap gap-2">
			for _, t := range p.Tags {
				@tag(t)
			}
		</div>
	}
}

templ Post(o content.Owner, p content.Post) {
	@layout(o, page{section: p.Title, current: "blog", description: p.Summary, path: postPath(p), article: true}) {
		@pageShell(true) {
			<article class="mx-auto max-w-3xl">
				<a href="/blog" class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-ink">
					<svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M19 12H5"></path>
						<path d="m12 19-7-7 7-7"></path>
					</svg>
					All posts
				</a>
				<header class="mt-10">
					@postMeta(p)
					<h1 class="mt-4 font-mono text-3xl font-bold tracking-tight text-ink sm:text-4xl">{ p.Title }</h1>
					<p class="mt-4 text-lg leading-relaxed text-ink/80">{ p.Summary }</p>
					@postTags(p)
				</header>
				@codeStyles()
				<div class="prose mt-12 max-w-none border-t border-line pt-12">
					@postBody(p)
				</div>
			</article>
		}
	}
}
